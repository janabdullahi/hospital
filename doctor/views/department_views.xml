<odoo>
  <data>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="hospital_department_list">
      <field name="name">hospital department list</field>
      <field name="model">hospital.department</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list editable="bottom">
          <field name="name" required="1"/>
        </list>
      </field>
    </record>


    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="hospital_department_action_window">
      <field name="name">Hospital Department</field>
      <field name="res_model">hospital.department</field>
      <field name="view_mode">list</field>
    </record>

    <!-- Top menu item -->
    <menuitem id="department_menu" name="Department" action="hospital_department_action_window" parent="doctor_menu_root"/>

  </data>
</odoo>
