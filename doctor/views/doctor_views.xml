<odoo>
  <data>

    <!-- explicit search view definition -->
    <record id="doctor_search_view" model="ir.ui.view">
      <field name="name">doctor.search.view</field>
      <field name="model">doctor.doctor</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
          <field name="doctor_ref_No" string="Ref No."/>
          <field name="name"/>
          <field name="last_name"/>
          <field name="doctor_index_number"/>
          <field name="gmc_ref_number"/>
          <field name="dob"/>
        </search>
      </field>
    </record>

    <!-- explicit kanabn view definition -->
    <record id="docotor_kanban_view" model="ir.ui.view">
      <field name="name">doctor.kanban.view</field>
      <field name="model">doctor.doctor</field>
      <field name="type">kanban</field>
      <field name="arch" type="xml">
        <kanban sample="1">
          <templates>
            <t t-name="card">
              <div class="text-truncate oe_kanban_global_click" width="100%">
                <table>
                  <tr>
                    <td><strong>Name:</strong></td>
                    <td style="display:flex; gap:5px;">
                      <field name="name"/>
                      <field name="last_name"/>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>DOB:</strong></td> 
                    <td><field name="dob"/></td>
                  </tr>
                  <tr>
                    <td><strong>Index No:</strong></td> 
                    <td><field name="doctor_index_number"/></td>
                  </tr>
                  <tr>
                    <td><strong>GMC No:</strong></td>
                    <td><field name="gmc_ref_number"/></td>
                  </tr>
                    <tr>
                    <td><strong>Phone:</strong></td>
                    <td><field name="private_phone"/></td>
                  </tr>
                  <tr>
                    <td><strong>Email:</strong></td>
                    <td><field name="private_email"/></td>
                  </tr>
                </table>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="doctor_list">
      <field name="name">doctor list</field>
      <field name="model">doctor.doctor</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list>
          <field name="doctor_ref_No" string="Ref No."/>
          <field name="name"/>
          <field name="last_name"/>
          <field name="dob" widget="badge"/>
          <field name="doctor_index_number"/>
          <field name="gmc_ref_number"/>
        </list>
      </field>
    </record>

        <!-- explicit form view definition -->
    <record model="ir.ui.view" id="doctor_form">
      <field name="name">doctor form</field>
      <field name="model">doctor.doctor</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <field name="image_1920" widget="image" class="oe_avatar"/>
            <div class="text-muted">Doctor Reference</div>
              <h2>
                <field name="doctor_ref_No" readonly="1"/>
              </h2>
            <group>
              <group>
                  <field name="name"/>
                  <field name="last_name"/>
                  <field name="dob" widget="badge"/>
                  <field name="place_of_birth"/>
                  <field name="country_of_birth" options="{'no_create': True, 'no_edit': True}"/>
                </group>
                <group>
                  <field name="gender"/>
                  <field name="nationality_id" options="{'no_create': True, 'no_edit': True}"/>
                  <field name="martial_status"/>
                  <field name="doctor_index_number"/>
                  <field name="gmc_ref_number"/>
                  <field name="department_id" options="{'no_create': True, 'no_edit': True}"/>
                </group>
            </group>
            <notebook>
              <page name="personal_information" string="Contact Information">
                <group>
                  <group string="Private Contact">
                    <field name="private_phone"/>
                    <field name="private_email"/>
                    <label for="private_street" string="Private Address"/>
                      <div class="o_address_format">
                        <field name="private_street" placeholder="Street..." class="o_address_street"/>
                        <field name="private_street2" placeholder="Street 2..." class="o_address_street"/>
                        <field name="private_city" placeholder="City" class="o_address_city"/>
                        <field name="private_state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': private_country_id}"/>
                        <field name="private_zip" placeholder="ZIP" class="o_address_zip"/>
                        <field name="private_country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                      </div>
                  </group>
                  <group string="Emergency Contact" name="emergency">
                    <field name="emergency_contact"/>
                    <field name="emergency_phone" class="o_force_ltr"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <chatter reload_on_follower="True"/>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="doctor_action_window">
      <field name="name">Doctor</field>
      <field name="res_model">doctor.doctor</field>
      <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Doctor" id="doctor_menu_root" action="doctor_action_window" groups="doctor.group_doctor_user,doctor.group_doctor_doctor,doctor.group_doctor_admin"/>

  </data>
</odoo>
