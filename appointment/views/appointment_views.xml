<odoo>
  <data>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="appointment_list">
      <field name="name">appointment list</field>
      <field name="model">appointment.appointment</field>
      <field name="arch" type="xml">
        <list>
          <field name="patient_id"/>
        </list>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="appointment_form">
      <field name="name">appointment form</field>
      <field name="model">appointment.appointment</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="patient_id" options="{'no_create': True, 'no_edit': True}"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="appointment_action_window">
      <field name="name">Appointment</field>
      <field name="res_model">appointment.appointment</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Appointment" id="appointment.menu_root" action="appointment_action_window"/>


  </data>
</odoo>
