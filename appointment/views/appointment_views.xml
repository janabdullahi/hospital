<odoo>
  <data>


    <!-- explicit search view definition -->
    <record id="appointment_search_view" model="ir.ui.view">
      <field name="name">appointment.search.view</field>
      <field name="model">appointment.appointment</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
          <field name="appointment_date" string="Appointment Date mm/dd/yyyy"/>
          <field name="patient_id" string="Patient Name"/>
          <filter string="Today's Appointments" name="appointment_date_today" domain="[('appointment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
          <separator/>
          <filter string="Tomorrow's Appointments" name="appointment_date_tomorrow" domain="[('appointment_date', '=', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
          <separator/>
          <filter string="Past Appointments" name="appointment_date_past" domain="[('appointment_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
          <separator/>
          <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
          <separator/>
          <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
          <separator/>
          <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
          <separator/>
        </search>
      </field>
    </record>


    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="appointment_list">
      <field name="name">appointment list</field>
      <field name="model">appointment.appointment</field>
      <field name="arch" type="xml">
        <list>
          <field name="appointment_ref_No" string="Ref No."/>
          <field name="patient_id"/>
          <field name="doctor_id"/>
          <field name="slot_id"/>
          <field name="appointment_date"/>
          <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'"/>
        </list>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="appointment_form">
      <field name="name">appointment form</field>
      <field name="model">appointment.appointment</field>
      <field name="arch" type="xml">
        <form>
          <header>
          <!-- Add this button in your appointment form view -->
            <button name="action_send_confirmation_request" string="Send Confirmation Request" type="object" class="btn-primary" invisible="state != 'draft'"/>
            <button name="confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'  or not id"/>
            <button name="cancel" string="Cancel" type="object" class="btn-primary" invisible="state not in ['draft', 'confirmed']  or not id"  groups="appointment.group_appointment_admin,appointment.group_appointment_doctor"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
          </header>
          <sheet>
            <div class="text-muted">Appointment Reference</div>
              <h2>
                <field name="appointment_ref_No" readonly="1"/>
              </h2>
            <group>
              <group>
                <field name="patient_id" options="{'no_create': True, 'no_edit': True}"/>
                <field name="appointment_date"/>
                </group>
                <group>
                <field name="doctor_id" options="{'no_create': True, 'no_edit': True}"/>
                <field name="slot_id" options="{'no_create': True, 'no_edit': True}"/>
              </group>
            </group>
            <notebook>
              <page name="personal_information" string="Patient Information">
                <group>
                  <group string="Personal Info">
                      <field name="last_name" readonly="1"/>
                      <field name="dob" readonly="1"/>
                      <field name="country_of_birth" readonly="1" options="{'no_open': True}"/>
                      <field name="nhs_number" readonly="1"/>
                      <field name="mrn_number" readonly="1"/>
                      <field name="gender" readonly="1"/>
                  </group>
                  <group string="Contact Details">
                    <field name="private_phone" readonly="1"/>
                    <field name="private_email" readonly="1"/>
                    <label for="private_street" string="Private Address"/>
                      <div class="o_address_format">
                        <field name="private_street" placeholder="Street..." class="o_address_street" readonly="1"/>
                        <field name="private_street2" placeholder="Street 2..." class="o_address_street" readonly="1"/>
                        <field name="private_city" placeholder="City" class="o_address_city"/>
                        <field name="private_state_id" class="o_address_state" placeholder="State" readonly="1"/>
                        <field name="private_zip" placeholder="ZIP" class="o_address_zip"  readonly="1"/>
                        <field name="private_country_id" placeholder="Country" class="o_address_country" readonly="1" options="{'no_open': True}"/>
                      </div>
                  </group>
                </group>
              </page>

              <page name="personal_information" string="Doctor Information">
                <group>
                  <group string="Personal Info">
                      <field name="doctor_last_name" readonly="1"/>
                      <field name="doctor_dob" readonly="1"/>
                      <field name="doctor_country_of_birth" readonly="1" options="{'no_open': True}"/>
                      <field name="doctor_index_number" readonly="1"/>
                      <field name="gmc_ref_number" readonly="1"/>
                      <field name="doctor_gender" readonly="1"/>
                  </group>
                  <group string="Contact Details">
                    <field name="doctor_private_phone" readonly="1"/>
                    <field name="doctor_private_email" readonly="1"/>
                    <label for="private_street" string="Private Address"/>
                      <div class="o_address_format">
                        <field name="doctor_private_street" placeholder="Street..." class="o_address_street" readonly="1"/>
                        <field name="doctor_private_street2" placeholder="Street 2..." class="o_address_street" readonly="1"/>
                        <field name="doctor_private_city" placeholder="City" class="o_address_city"/>
                        <field name="doctor_private_state_id" class="o_address_state" placeholder="State" readonly="1"/>
                        <field name="doctor_private_zip" placeholder="ZIP" class="o_address_zip"  readonly="1"/>
                        <field name="doctor_private_country_id" placeholder="Country" class="o_address_country" readonly="1" options="{'no_open': True}"/>
                      </div>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <chatter reload_on_follower="True"/>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="appointment_action_window">
      <field name="name">Appointment</field>
      <field name="res_model">appointment.appointment</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Appointment" id="appointment.menu_root" action="appointment_action_window"/>


  </data>
</odoo>
