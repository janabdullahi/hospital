<odoo>
  <data>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="appointment_slot">
      <field name="name">appointment slot</field>
      <field name="model">appointment.slot</field>
      <field name="arch" type="xml">
        <list editable="bottom">
          <field name="name" required="1"/>
          <field name="capacity"/>
        </list>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="appointment_slot_action_window">
      <field name="name">Appointment Slot</field>
      <field name="res_model">appointment.slot</field>
      <field name="view_mode">list</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Appointment Slot" id="appointment_slot_menu_root" action="appointment_slot_action_window" parent="appointment.menu_root"/>


  </data>
</odoo>
