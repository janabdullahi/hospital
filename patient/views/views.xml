<odoo>
  <data>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="patient.list">
      <field name="name">patient list</field>
      <field name="model">patient.patient</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list>
          <field name="patient_ref_No" string="Ref No."/>
          <field name="name"/>
          <field name="last_name"/>
          <field name="dob" widget="badge"/>
        </list>
      </field>
    </record>


    <!-- actions opening form views on models -->
    <record model="ir.ui.view" id="patient.form">
        <field name="name">patient form</field>
        <field name="model">patient.patient</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
          <form>
            <sheet>            
              <div class="text-muted">Patient Reference</div>
              <h2>
                <field name="patient_ref_No" readonly="1"/>
              </h2>
              <group>
                <group>
                  <field name="name"/>
                  <field name="middle_name"/>
                  <field name="last_name"/>
                  <field name="dob" widget="date"/>
                </group>
                <group>
                  <field name="gender"/>
                  <field name="nationality_id" options="{'no_create': True, 'no_edit': True}"/>
                  <field name="martial_status"/>
                </group>
              </group>

            <notebook>
              <page name="personal_information" string="Contact Information">
                <group>
                  <group string="Private Contact">
                        <field name="private_phone"/>
                        <field name="private_email"/>
                    <label for="private_street" string="Private Address"/>
                      <div class="o_address_format">
                        <field name="private_street" placeholder="Street..." class="o_address_street"/>
                        <field name="private_street2" placeholder="Street 2..." class="o_address_street"/>
                        <field name="private_city" placeholder="City" class="o_address_city"/>
                        <field name="private_state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': private_country_id}"/>
                        <field name="private_zip" placeholder="ZIP" class="o_address_zip"/>
                        <field name="private_country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                      </div>
                  </group>
                  <group string="Emergency Contact" name="emergency">
                    <field name="emergency_contact"/>
                    <field name="emergency_phone" class="o_force_ltr"/>
                  </group>
                </group>
              </page>
              <page name="medical_information" string="Medical Information">
                <group>
                  <group string="Medical History" name="medical">
                      <field name="medical_history"/>
                      <field name="family_medical_history"/>
                      <field name="current_medication"/>
                  </group>
                  <group string="Vitals" name="vital">
                      <field name="allergies"/>
                      <field name="blood_group"/>
                      <field name="height"/>
                      <field name="weight"/>
                  </group>
                </group>
              </page>
            </notebook>
            </sheet>
          </form>
        </field>
    </record>


    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="patient.action_window">
      <field name="name">Patient</field>
      <field name="res_model">patient.patient</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- Top menu item -->
    <menuitem name="Patient" id="patient.menu_root" action="patient.action_window"/>

  </data>
</odoo>
